{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vidangquoc/PTNK/blob/main/schemas/knowledge-atom.schema.json",
  "title": "PTNK Knowledge Atom",
  "description": "Schema for a source-grounded, independently referenceable unit of knowledge. This is a data contract, not a learning-priority model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_atom_id",
    "source_id",
    "source_type",
    "source_location",
    "section_type",
    "atom_type",
    "canonical_form",
    "content_status",
    "provenance_status"
  ],
  "properties": {
    "knowledge_atom_id": {
      "type": "string",
      "pattern": "^ka-[a-z0-9][a-z0-9._:-]*$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["textbook", "exam", "reference", "other"]
    },
    "source_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "section_file", "line_start", "line_end"],
      "properties": {
        "unit": { "type": "integer", "minimum": 1, "maximum": 26 },
        "section_file": { "type": "string", "minLength": 1 },
        "section_index": { "type": "integer", "minimum": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "source_page": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "section_type": {
      "type": "string",
      "enum": ["main", "lexical", "assessment", "unknown"]
    },
    "section_name": {
      "type": "string",
      "minLength": 1
    },
    "atom_type": {
      "type": "string",
      "enum": [
        "word",
        "multiword_expression",
        "idiom",
        "phrasal_verb",
        "collocation",
        "fixed_expression",
        "grammar_rule",
        "grammar_pattern",
        "lexical_contrast",
        "word_formation",
        "usage_restriction",
        "meaning_distinction",
        "example_or_context",
        "unknown"
      ]
    },
    "canonical_form": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": ["string", "null"]
    },
    "definition": {
      "type": ["string", "null"]
    },
    "meaning_vi": {
      "type": ["string", "null"]
    },
    "pronunciation": {
      "type": ["string", "null"]
    },
    "patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "usage_note": {
      "type": ["string", "null"]
    },
    "examples": {
      "type": "array",
      "items": { "type": "string" }
    },
    "word_formation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_form": { "type": ["string", "null"] },
        "derived_form": { "type": ["string", "null"] },
        "relationship": { "type": ["string", "null"] }
      }
    },
    "cefr": {
      "type": ["string", "null"]
    },
    "cefr_status": {
      "type": "string",
      "enum": ["verified", "unverified", "pending", "not_applicable"]
    },
    "domain": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "pending"]
    },
    "content_status": {
      "type": "string",
      "enum": ["source_candidate", "curated", "verified", "rejected"]
    },
    "provenance_status": {
      "type": "string",
      "enum": ["complete", "partial", "pending"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_id"],
        "properties": {
          "kind": { "type": "string" },
          "source_id": { "type": "string", "minLength": 1 },
          "location": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship_type", "target_id"],
        "properties": {
          "relationship_type": { "type": "string", "minLength": 1 },
          "target_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  }
}
