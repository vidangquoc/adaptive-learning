{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "id",
    "domain",
    "type",
    "relation_type",
    "name",
    "part_of_speech",
    "pronunciation",
    "meaning",
    "mother_says",
    "explanation",
    "structure",
    "examples",
    "extra"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "vocabulary",
        "grammar"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "lexical_sense",
        "multiword_expression",
        "phrasal_verb",
        "idiom",
        "collocation",
        "word_formation",
        "morphological_form",
        "rule",
        "usage",
        "exception",
        "relation"
      ]
    },
    "relation_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "part_of_speech": {
      "type": [
        "string",
        "null"
      ]
    },
    "pronunciation": {
      "type": [
        "string",
        "null"
      ]
    },
    "meaning": {
      "type": [
        "string",
        "null"
      ]
    },
    "mother_says": {
      "type": [
        "string",
        "null"
      ]
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "structure": {
      "type": [
        "string",
        "null"
      ]
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extra": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "source",
        "is_tested",
        "test_evidence",
        "notes"
      ],
      "properties": {
        "source": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "origin",
            "atom_decision"
          ],
          "properties": {
            "origin": {
              "$ref": "#/$defs/sourceRecords"
            },
            "atom_decision": {
              "$ref": "#/$defs/sourceRecords"
            }
          }
        },
        "is_tested": {
          "type": "boolean"
        },
        "test_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "domain": {
            "const": "vocabulary"
          },
          "type": {
            "const": "lexical_sense"
          }
        },
        "required": [
          "domain",
          "type"
        ]
      },
      "then": {
        "properties": {
          "part_of_speech": {
            "type": "string",
            "minLength": 1
          },
          "pronunciation": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "domain": {
              "const": "vocabulary"
            },
            "type": {
              "const": "lexical_sense"
            }
          },
          "required": [
            "domain",
            "type"
          ]
        }
      },
      "then": {
        "properties": {
          "part_of_speech": {
            "type": "null"
          },
          "pronunciation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "vocabulary"
          }
        },
        "required": [
          "domain"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "lexical_sense",
              "multiword_expression",
              "phrasal_verb",
              "idiom",
              "collocation",
              "word_formation",
              "morphological_form"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "grammar"
          }
        },
        "required": [
          "domain"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "rule",
              "usage",
              "exception",
              "word_formation",
              "morphological_form",
              "relation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "relation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "relation_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "relation_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "const": "relation"
            }
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "relation_type": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": [
          "source_id",
          "segment_id",
          "location"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "page",
              "section",
              "line"
            ],
            "properties": {
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://github.com/vidangquoc/adaptive-learning/schema/official-atom",
  "title": "Official Knowledge Atom"
}
