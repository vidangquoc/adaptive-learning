{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vidangquoc/adaptive-learning/schema/candidate-atom",
  "title": "Candidate Knowledge Atom",
  "allOf": [
    {
      "$ref": "./knowledge-atom-common.schema.json"
    }
  ],
  "properties": {
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    }
  },
  "required": [
    "review_status"
  ],
  "unevaluatedProperties": false
}
